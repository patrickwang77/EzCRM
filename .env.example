# EzCRM Environment Variables
# Copy to .env.local for Firebase Cloud mode. Leave Firebase keys blank to run in localStorage demo mode.

VITE_CLEAN_START=true
VITE_DEFAULT_VARIANT=A
VITE_SHOW_VARIANT_SWITCHER=false

# Firebase Web App Configuration (optional — enables Google Auth + Cloud Firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
